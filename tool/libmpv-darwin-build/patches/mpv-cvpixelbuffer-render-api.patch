diff --git a/video/out/libmpv_cvpixelbuffer.c b/video/out/libmpv_cvpixelbuffer.c
new file mode 100644
index 0000000..83e2c66
--- /dev/null
+++ b/video/out/libmpv_cvpixelbuffer.c
@@ -0,0 +1,147 @@
+#include "config.h"
+
+#include <libavutil/hwcontext.h>
+
+#include "mpv/render.h"
+#include "libmpv.h"
+#include "video/hwdec.h"
+#include "video/img_format.h"
+#include "video/mp_image.h"
+
+struct priv {
+    struct mp_image_params params;
+    struct mp_hwdec_ctx hwctx;
+};
+
+static int init(struct render_backend *ctx, mpv_render_param *params)
+{
+    char *api = get_mpv_render_param(params, MPV_RENDER_PARAM_API_TYPE, NULL);
+    if (!api)
+        return MPV_ERROR_INVALID_PARAMETER;
+    if (strcmp(api, MPV_RENDER_API_TYPE_CVPIXELBUFFER) != 0)
+        return MPV_ERROR_NOT_IMPLEMENTED;
+#if !HAVE_DARWIN
+    return MPV_ERROR_NOT_IMPLEMENTED;
+#else
+    struct priv *p = ctx->priv = talloc_zero(NULL, struct priv);
+    ctx->hwdec_devs = hwdec_devices_create();
+    p->hwctx = (struct mp_hwdec_ctx) {
+        .driver_name = "videotoolbox-cvpixelbuffer",
+        .hw_imgfmt = IMGFMT_VIDEOTOOLBOX,
+    };
+    int ret = av_hwdevice_ctx_create(&p->hwctx.av_device_ref,
+                                     AV_HWDEVICE_TYPE_VIDEOTOOLBOX,
+                                     NULL, NULL, 0);
+    if (ret < 0) {
+        hwdec_devices_destroy(ctx->hwdec_devs);
+        ctx->hwdec_devs = NULL;
+        return MPV_ERROR_GENERIC;
+    }
+    hwdec_devices_add(ctx->hwdec_devs, &p->hwctx);
+    ctx->driver_caps = VO_CAP_ROTATE90 | VO_CAP_VFLIP;
+    return 0;
+#endif
+}
+
+static bool check_format(struct render_backend *ctx, int imgfmt)
+{
+    return imgfmt == IMGFMT_VIDEOTOOLBOX;
+}
+
+static int set_parameter(struct render_backend *ctx, mpv_render_param param)
+{
+    return MPV_ERROR_NOT_IMPLEMENTED;
+}
+
+static void reconfig(struct render_backend *ctx, struct mp_image_params *params)
+{
+    struct priv *p = ctx->priv;
+    p->params = *params;
+}
+
+static void reset(struct render_backend *ctx)
+{
+}
+
+static void update_external(struct render_backend *ctx, struct vo *vo)
+{
+}
+
+static void resize(struct render_backend *ctx, struct mp_rect *src,
+                   struct mp_rect *dst, struct mp_osd_res *osd)
+{
+}
+
+static int get_target_size(struct render_backend *ctx, mpv_render_param *params,
+                           int *out_w, int *out_h)
+{
+    int *size = get_mpv_render_param(
+        params, MPV_RENDER_PARAM_CVPIXELBUFFER_SIZE, NULL);
+    if (!size || size[0] <= 0 || size[1] <= 0)
+        return MPV_ERROR_INVALID_PARAMETER;
+    *out_w = size[0];
+    *out_h = size[1];
+    return 0;
+}
+
+static int render(struct render_backend *ctx, mpv_render_param *params,
+                  struct vo_frame *frame)
+{
+    mpv_render_cvpixelbuffer_fn *callback_ptr = get_mpv_render_param(
+        params, MPV_RENDER_PARAM_CVPIXELBUFFER_CALLBACK, NULL);
+    if (!callback_ptr || !*callback_ptr)
+        return MPV_ERROR_INVALID_PARAMETER;
+
+    void *callback_ctx = get_mpv_render_param(
+        params, MPV_RENDER_PARAM_CVPIXELBUFFER_CALLBACK_CTX, NULL);
+    mpv_render_cvpixelbuffer_frame native = {0};
+    struct mp_image *image = frame ? frame->current : NULL;
+    if (image) {
+        if (image->imgfmt != IMGFMT_VIDEOTOOLBOX || !image->planes[3])
+            return MPV_ERROR_UNSUPPORTED;
+
+        int display_w = image->w;
+        int display_h = image->h;
+        mp_image_params_get_dsize(&image->params, &display_w, &display_h);
+        native = (mpv_render_cvpixelbuffer_frame) {
+            .pixel_buffer = image->planes[3],
+            .width = image->w,
+            .height = image->h,
+            .display_width = display_w,
+            .display_height = display_h,
+            .crop_x0 = image->params.crop.x0,
+            .crop_y0 = image->params.crop.y0,
+            .crop_x1 = image->params.crop.x1,
+            .crop_y1 = image->params.crop.y1,
+            .rotate = image->params.rotate,
+            .pts = image->pts,
+        };
+    }
+
+    int result = (*callback_ptr)(callback_ctx, &native);
+    return result < 0 ? result : 0;
+}
+
+static void destroy(struct render_backend *ctx)
+{
+    struct priv *p = ctx->priv;
+    if (ctx->hwdec_devs && p) {
+        hwdec_devices_remove(ctx->hwdec_devs, &p->hwctx);
+        av_buffer_unref(&p->hwctx.av_device_ref);
+        hwdec_devices_destroy(ctx->hwdec_devs);
+        ctx->hwdec_devs = NULL;
+    }
+}
+
+const struct render_backend_fns render_backend_cvpixelbuffer = {
+    .init = init,
+    .check_format = check_format,
+    .set_parameter = set_parameter,
+    .reconfig = reconfig,
+    .reset = reset,
+    .update_external = update_external,
+    .resize = resize,
+    .get_target_size = get_target_size,
+    .render = render,
+    .destroy = destroy,
+};
