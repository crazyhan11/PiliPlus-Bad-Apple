+/**
+ * A VideoToolbox frame exposed by MPV_RENDER_API_TYPE_CVPIXELBUFFER.
+ *
+ * pixel_buffer is a CVPixelBufferRef. It is borrowed and remains valid only
+ * for the duration of mpv_render_cvpixelbuffer_fn. The API deliberately uses
+ * void* so this public header does not require Apple framework headers.
+ */
+typedef struct mpv_render_cvpixelbuffer_frame {
+    void *pixel_buffer;
+    int width;
+    int height;
+    int display_width;
+    int display_height;
+    int crop_x0;
+    int crop_y0;
+    int crop_x1;
+    int crop_y1;
+    int rotate;
+    double pts;
+} mpv_render_cvpixelbuffer_frame;
+
+/**
+ * Render a borrowed VideoToolbox frame into a host-owned target.
+ *
+ * Returning 0 reports success. A negative value aborts this render call.
+ * The callback is invoked synchronously by mpv_render_context_render().
+ */
+typedef int (*mpv_render_cvpixelbuffer_fn)(
+    void *callback_ctx,
+    const mpv_render_cvpixelbuffer_frame *frame);
+
